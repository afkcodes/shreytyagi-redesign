{
  "name": "shreytyagi-redesign",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "preview": "wrangler dev",
    "check": "astro check",
    "verify": "astro check && astro build --force && node scripts/verify.mjs",
    "new": "node scripts/new.mjs",
    "media:import": "node scripts/import-media.mjs",
    "deploy": "wrangler deploy",
    "migrate:old-site": "python3 scripts/migrate/extract.py && node scripts/migrate/to-markdown.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "astro": "^7.4.13",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
